# Solo nombres y valores de ejemplo. No copiar secretos reales a este archivo.
# La web pública arranca en modo demostración sin ninguna de estas variables.

# demo | development | production
APP_ENV=demo

# Ejemplo de forma; no es una conexión real ni debe contener credenciales reales aquí.
# DATABASE_URL=postgresql://USUARIO:CLAVE@HOST:5432/BASEDEDATOS

# La bandera no habilita cobros en esta entrega. La pasarela sigue deshabilitada.
PAYMENTS_ENABLED=false

# Proveedor previsto; vacío hasta que exista una integración verificada.
PAYMENT_PROVIDER=
